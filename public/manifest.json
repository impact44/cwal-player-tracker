{
  "manifest_version": 3,
  "name": "CWAL Pro Player Marker",
  "version": "1.01",
  "description": "Marks known StarCraft pros on cwal.gg player profiles.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://cwal.gg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cwal.gg/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/edit.png"
      ],
      "matches": [
        "https://cwal.gg/*"
      ]
    }
  ],
  "action": {
    "default_title": "CWAL Pro Extension",
    "default_popup": "index.html"
  }
}